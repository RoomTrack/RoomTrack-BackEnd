#### RoomTrack on Azure Container Apps - settings of deploy/azure/deploy.ps1
#
# Copy this file to `roomtrack.azure.env` (same folder, git-ignored) and fill in the values marked REQUIRED.
# One KEY=VALUE per line, no quotes. Leave the GENERATED values empty: the first run of deploy.ps1 creates random
# values and writes them back into roomtrack.azure.env, so later runs reuse the same ones. Never commit that file.

# --- Azure ---------------------------------------------------------------------------------------------------------
# Azure for Students only allows: westus3, mexicocentral, southcentralus, canadacentral, chilecentral
AZURE_LOCATION=chilecentral
AZURE_RESOURCE_GROUP=rg-roomtrack
AZURE_ENVIRONMENT=cae-roomtrack
# Docker images published by .github/workflows/docker-publish.yml (the GHCR packages must be public)
IMAGE_PREFIX=ghcr.io/roomtrack/roomtrack-backend
IMAGE_TAG=main

# --- MySQL (Azure Database for MySQL - Flexible Server) ------------------------------------------------------------
# GENERATED: globally unique server name (roomtrack-mysql-xxxxx)
MYSQL_SERVER_NAME=
MYSQL_ADMIN_USER=roomtrackadmin
# GENERATED
MYSQL_ADMIN_PASSWORD=
# GENERATED: one user per service (identity_svc, accommodations_svc, ...)
MYSQL_IDENTITY_PASSWORD=
MYSQL_ACCOMMODATIONS_PASSWORD=
MYSQL_BOOKINGS_PASSWORD=
MYSQL_PROFILES_PASSWORD=
MYSQL_ANALYTICS_PASSWORD=

# --- Shared by every service ---------------------------------------------------------------------------------------
# GENERATED (JWT secret, X-Internal-Key, X-Cron-Key). Copy CRON_API_KEY to the CRON_API_KEY secret of the repository.
TOKEN_SECRET=
INTERNAL_API_KEY=
CRON_API_KEY=
APP_WEB_BASE_URL=https://roomtrack-web.vercel.app
APP_LANDING_BASE_URL=https://roomtrack-landing.vercel.app
CORS_ALLOWED_ORIGINS=https://roomtrack-web.vercel.app,https://roomtrack-landing.vercel.app

# --- RabbitMQ (CloudAMQP: instance > Details > AMQP URL amqp://USER:PASSWORD@HOST/VHOST) ---------------------------
# REQUIRED
RABBITMQ_HOST=
RABBITMQ_VHOST=
RABBITMQ_USER=
RABBITMQ_PASSWORD=
RABBITMQ_PORT=5672

# --- Identity --------------------------------------------------------------------------------------------------------
# REQUIRED: first global chain_admin, seeded on the first start (empty database)
INITIAL_CHAIN_ADMIN_EMAIL=
INITIAL_CHAIN_ADMIN_PASSWORD=

# --- Accommodations (Cloudinary console > Settings > API Keys) -----------------------------------------------------
# REQUIRED
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Profiles --------------------------------------------------------------------------------------------------------
# REQUIRED
SALES_NOTIFICATION_EMAIL=
DEMO_SCHEDULING_URL=https://cal.com/roomtrack/demo-roomtrack

# --- Notifications worker (Brevo > SMTP & API > API keys) ----------------------------------------------------------
# REQUIRED
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=RoomTrack
# Log | Fcm. Fcm also needs Push__Fcm__ServiceAccountJson, which this script does not set (add it in the portal).
PUSH_TRANSPORT=Log

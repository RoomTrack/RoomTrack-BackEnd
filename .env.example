# SmartStay backend - environment variables (example)
#
# This file is read by DOCKER COMPOSE, not by the application: copy it to `.env` and `docker compose up` passes the
# values to the API container (`env_file`) and uses them for variable substitution in docker-compose.yml.
# The API itself only reads appsettings.json, appsettings.{Environment}.json, user-secrets (Development) and
# environment variables. In production (Render) set these values as environment variables (or secret files) of the
# service; never commit real values (`.env` is git-ignored).
# ASP.NET Core maps `__` (double underscore) to the `:` configuration separator.

# --- Runtime -----------------------------------------------------------------
# Development | Production. Production disables dev defaults (DB, JWT secret, CORS).
ASPNETCORE_ENVIRONMENT=Production

# --- Database (REQUIRED outside Development) ----------------------------------
# MySQL 8 ADO.NET connection string. For managed MySQL (Aiven) verify the server certificate:
# `SslMode=VerifyFull;SslCa=/etc/secrets/ca.pem;` (upload the CA certificate of Aiven as a Render secret file).
ConnectionStrings__DefaultConnection=server=mysql;port=3306;user=smartstay;password=change-me;database=smartstay;
# Optional. MySQL server version used by EF Core (default 8.0.36). Avoids AutoDetect round-trips.
Database__MySqlServerVersion=8.0.36

# --- JWT (REQUIRED outside Development) ---------------------------------------
# At least 32 random characters, e.g. `openssl rand -base64 48`. The app refuses to start without it.
TokenSettings__Secret=
# Optional (defaults: smartstay-api / smartstay-clients). Only need to be self-consistent.
TokenSettings__Issuer=smartstay-api
TokenSettings__Audience=smartstay-clients
# Lifetime of an access token (default 30). "Remember me" sessions last through refresh tokens.
TokenSettings__AccessTokenExpirationMinutes=30
# Lifetime of the second-factor challenge token (mfaToken) returned by sign-in to staff (default 10).
TokenSettings__MfaChallengeTokenExpirationMinutes=10

# --- Two-factor authentication, TOTP (US-52) -----------------------------------
# Name shown by the authenticator app next to the account (otpauth issuer). No ':'.
Mfa__Issuer=SmartStay

# --- Data Protection (encryption of MFA secrets and identity documents) --------
# The key ring is stored in the database (table data_protection_keys) so it survives Render restarts.
# Every instance must use the same application name.
DataProtection__ApplicationName=SmartStay
# Optional: PKCS#12 certificate (base64 of the .pfx) that encrypts the keys at rest, and its password.
DataProtection__CertificatePfxBase64=
DataProtection__CertificatePassword=

# --- Password policy (NIST SP 800-63B-4) -----------------------------------------
# Staff min 8, guests min 15, max 128, no composition rules; common and breached passwords rejected.
# Breached passwords: Have I Been Pwned range API (k-anonymity: only 5 hex chars of the SHA-1 leave the server).
# If the API cannot be reached within the timeout the password is accepted and a warning is logged (fail open).
PasswordPolicy__BreachedPasswordCheckEnabled=true
PasswordPolicy__PwnedPasswordsApiBaseUrl=https://api.pwnedpasswords.com/
PasswordPolicy__PwnedPasswordsTimeoutSeconds=3

# --- Client URLs (REQUIRED) ---------------------------------------------------
# Public URL of the web app: e-mail links go to /verify-email, /reset-password, /forgot-password and /login.
App__WebBaseUrl=https://smartstay-3cffc.web.app
# Public URL of the landing: demo request e-mails link to its /#demo section.
App__LandingBaseUrl=https://smartstay.vercel.app

# --- E-mail (REQUIRED in Production) ------------------------------------------
# Brevo SMTP relay. In Production the app refuses to start without Email__Smtp__Host and Email__From__Address.
# Without SMTP (Development) e-mails are written to the log, links included.
Email__Smtp__Host=smtp-relay.brevo.com
Email__Smtp__Port=587
Email__Smtp__Username=b9e733001@smtp-brevo.com
# SMTP key of Brevo (Settings > SMTP & API). Set it only in the hosting provider (Render), never in the repo.
Email__Smtp__Password=
# STARTTLS on 587 (implicit TLS on 465). Only false for a local test SMTP server.
Email__Smtp__EnableSsl=true
# Verified sender of Brevo.
Email__From__Address=psulcasanchez@gmail.com
Email__From__Name=SmartStay

# --- Account security (optional, defaults shown) ------------------------------
AccountSecurity__LockoutMaxFailedAttempts=5
AccountSecurity__LockoutDurationMinutes=15
AccountSecurity__EmailVerificationTokenLifetimeHours=24
AccountSecurity__PasswordResetTokenLifetimeMinutes=30
AccountSecurity__RefreshTokenLifetimeDays=30

# --- Rate limiting per client IP (optional, defaults shown) -------------------
# sign-in, sign-up, verify-email (+resend), password-recovery, password-reset and the MFA endpoints
RateLimiting__CredentialsPermitLimit=10
RateLimiting__CredentialsWindowSeconds=60
# POST /api/v1/demo-requests
RateLimiting__PublicFormsPermitLimit=5
RateLimiting__PublicFormsWindowSeconds=300
# Behind a reverse proxy (Render) take the client IP from X-Forwarded-For (rate limiting, audit log).
ASPNETCORE_FORWARDEDHEADERS_ENABLED=true

# --- Demo requests of the landing (US-27) --------------------------------------
# Sales inbox notified of every demo request (REQUIRED).
Sales__NotificationEmail=psulcasanchez@gmail.com
# Hours a request waits before the automatic follow-up (default 48).
DemoRequests__FollowUpAfterHours=48
# Public scheduling page of the sales team (Cal.com). The confirmation and 48 h follow-up
# e-mails link straight to it, prefilled with ?name=...&email=... of the visitor.
DemoRequests__SchedulingUrl=https://cal.com/piero-sulca-sanchez-rhh1nt/demo-smartstay
# Shared secret of the scheduler (GitHub Actions cron) sent as X-Cron-Key to
# POST /api/v1/demo-requests/follow-ups (REQUIRED, at least 32 chars: `openssl rand -hex 32`).
Cron__ApiKey=

# --- Bookings (US-51, US-07) ---------------------------------------------------
# IANA time zone of the hotels: decides "today" (no check-in in the past, no cancellation on the check-in day).
Bookings__TimeZone=America/Lima
# Hours a Pending booking waits for its payment before it is cancelled (payment hold).
Bookings__PaymentHoldHours=24
# Check-out time (HH:mm, hotel time).
Bookings__CheckOutTime=12:00

# Payment methods (Yape, Plin, bank account) are NOT environment variables: each hotel administrator sets them in
# the app (PUT /api/v1/hotels/{id}/payment-settings). A hotel without payment methods does not accept bookings.

# --- Rooms (US-06) ------------------------------------------------------------------
# Hours in Maintenance before the hotel admins get an alert (default 24).
Rooms__MaintenanceAlertAfterHours=24

# --- Scheduled jobs (external scheduler, e.g. GitHub Actions cron, header X-Cron-Key: $Cron__ApiKey) --------
#   POST /api/v1/demo-requests/follow-ups     (hourly)
#   POST /api/v1/bookings/expire-pending      (every 15-60 minutes)
#   POST /api/v1/rooms/maintenance-alerts     (hourly)

# --- First administrator (recommended) ---------------------------------------
# Seeded once at startup as a global chain_admin (hotelId=1) if that e-mail is not registered yet (InitialChainAdmin__Email must be an e-mail).
InitialChainAdmin__Email=
InitialChainAdmin__Password=

# --- CORS ---------------------------------------------------------------------
# Comma-separated list of allowed browser origins (no trailing slash): the web app AND the landing.
# Empty = no cross-origin browser access. Development defaults to http://localhost:5173,5174 and 4173.
Cors__AllowedOrigins=https://smartstay-3cffc.web.app,https://smartstay.vercel.app

# --- Optional: analytics cache lab (Redis + ActiveMQ fallback) ----------------
# When empty, /api/v1/analytics/cache returns 503 and nothing connects to Redis/ActiveMQ.
ConnectionStrings__RedisConnection=
# e.g. tcp://activemq:61616 . Only used as fallback when Redis is configured but failing.
Messaging__ActiveMqBrokerUri=

# --- docker compose only (local MySQL container) -------------------------------
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=smartstay
MYSQL_USER=smartstay
MYSQL_PASSWORD=change-me
API_PORT=10000

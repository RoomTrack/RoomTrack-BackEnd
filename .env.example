#### RoomTrack microservices - environment variables (example)
#
# Read by DOCKER COMPOSE, not by the services: copy it to `.env` and `docker compose up` uses the values for the
# variable substitution of docker-compose.yml and passes the whole file to every service container (`env_file`).
# Never commit real values (`.env` is git-ignored). ASP.NET Core maps `__` (double underscore) to `:`.
# Without .env the local development defaults of docker-compose.yml are used.

# --- Runtime -----------------------------------------------------------------
# Development | Production. Production requires real secrets and a real e-mail transport.
ASPNETCORE_ENVIRONMENT=Development

# --- Shared by every service (must be identical everywhere) -------------------
# JWT: Identity signs the tokens, every service validates them. At least 32 random characters (openssl rand -base64 48).
TOKEN_SECRET=
# Calls between services (/internal/v1, header X-Internal-Key). At least 32 random characters (openssl rand -hex 32).
INTERNAL_API_KEY=
# External scheduler (header X-Cron-Key). At least 32 random characters.
CRON_API_KEY=
# RabbitMQ credentials (also used to create the broker's default user).
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# --- Ports published on the host ----------------------------------------------
GATEWAY_PORT=8080
MYSQL_PORT=3306
RABBITMQ_PORT=5672
RABBITMQ_CONSOLE_PORT=15672
MYSQL_ROOT_PASSWORD=roomtrack_root_dev

# --- Client URLs ----------------------------------------------------------------
# E-mail links go to the web app (/verify-email, /reset-password...) and the landing (/#demo).
APP_WEB_BASE_URL=http://localhost:5173
APP_LANDING_BASE_URL=http://localhost:5174
# Browser origins allowed by the gateway (comma-separated, no trailing slash).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:4173

# --- Identity service -------------------------------------------------------------
# First administrator, seeded once as a global chain_admin if that e-mail is not registered yet.
INITIAL_CHAIN_ADMIN_EMAIL=
INITIAL_CHAIN_ADMIN_PASSWORD=
# Optional (defaults shown)
Mfa__Issuer=RoomTrack
AccountSecurity__LockoutMaxFailedAttempts=5
AccountSecurity__LockoutDurationMinutes=15
PasswordPolicy__BreachedPasswordCheckEnabled=true

# --- Profiles service (demo requests of the landing) -----------------------------------
SALES_NOTIFICATION_EMAIL=ventas@roomtrack.local
DemoRequests__FollowUpAfterHours=48

# --- Bookings service -------------------------------------------------------------
Bookings__TimeZone=America/Lima
Bookings__PaymentHoldHours=24
Bookings__CheckOutTime=12:00

# --- Accommodations service --------------------------------------------------------
Rooms__MaintenanceAlertAfterHours=24
# Signed uploads of hotel images (required in Production). Cloudinary console > Settings > API Keys.
Cloudinary__CloudName=
Cloudinary__ApiKey=
Cloudinary__ApiSecret=

# --- Notifications worker (e-mail delivery) ---------------------------------------
# BrevoApi (production) | Smtp (e.g. Mailpit) | Log (written to the log; not allowed in Production)
Email__Transport=Log
# SECRET. Brevo > SMTP & API > API keys.
Email__Brevo__ApiKey=
Email__From__Address=no-reply@roomtrack.local
Email__From__Name=RoomTrack
Email__Smtp__Host=
Email__Smtp__Port=587
Email__Smtp__Username=
Email__Smtp__Password=
Email__Smtp__EnableSsl=true
# Retries of transient failures with exponential backoff (defaults shown); then the message goes to the _error queue.
Email__Retry__MaxAttempts=8
Email__Retry__InitialRetryDelaySeconds=30
Email__Retry__MaxRetryDelayMinutes=60

# --- Analytics resilience lab (optional: docker compose --profile lab up) ------------
ANALYTICS_REDIS_CONNECTION=
ANALYTICS_ACTIVEMQ_URI=

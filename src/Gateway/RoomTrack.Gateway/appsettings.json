{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": ""
  },
  "Documentation": {
    "Services": {
      "identity": "Identity (accounts, sessions, audit)",
      "accommodations": "Accommodations (hotels, rooms, media, IoT)",
      "bookings": "Bookings (bookings, check-in, payments)",
      "profiles": "Profiles (guests, staff, demo requests)",
      "analytics": "Analytics (metrics)"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "identity-authentication": { "ClusterId": "identity", "Match": { "Path": "/api/v1/authentication/{**catch-all}" } },
      "identity-users": { "ClusterId": "identity", "Match": { "Path": "/api/v1/users/{**catch-all}" } },
      "identity-audit-logs": { "ClusterId": "identity", "Match": { "Path": "/api/v1/audit-logs/{**catch-all}" } },

      "accommodations-options": { "ClusterId": "accommodations", "Match": { "Path": "/api/v1/accommodations/{**catch-all}" } },
      "accommodations-hotels": { "ClusterId": "accommodations", "Match": { "Path": "/api/v1/hotels/{**catch-all}" } },
      "accommodations-rooms": { "ClusterId": "accommodations", "Match": { "Path": "/api/v1/rooms/{**catch-all}" } },
      "accommodations-room-types": { "ClusterId": "accommodations", "Match": { "Path": "/api/v1/room-types/{**catch-all}" } },
      "accommodations-media": { "ClusterId": "accommodations", "Match": { "Path": "/api/v1/media/{**catch-all}" } },
      "accommodations-iot": { "ClusterId": "accommodations", "Match": { "Path": "/api/v1/io-t-emulator/{**catch-all}" } },

      "bookings-bookings": { "ClusterId": "bookings", "Match": { "Path": "/api/v1/bookings/{**catch-all}" } },
      "bookings-payments": { "ClusterId": "bookings", "Match": { "Path": "/api/v1/payments/{**catch-all}" } },
      "bookings-room-availability": { "ClusterId": "bookings", "Order": -1, "Match": { "Path": "/api/v1/rooms/available" } },

      "profiles-guests": { "ClusterId": "profiles", "Match": { "Path": "/api/v1/guests/{**catch-all}" } },
      "profiles-staff": { "ClusterId": "profiles", "Match": { "Path": "/api/v1/staff/{**catch-all}" } },
      "profiles-demo-requests": { "ClusterId": "profiles", "Match": { "Path": "/api/v1/demo-requests/{**catch-all}" } },

      "analytics": { "ClusterId": "analytics", "Match": { "Path": "/api/v1/analytics/{**catch-all}" } },

      "docs-identity": { "ClusterId": "identity", "Match": { "Path": "/docs/identity/swagger/{**catch-all}" }, "Transforms": [ { "PathRemovePrefix": "/docs/identity" } ] },
      "docs-accommodations": { "ClusterId": "accommodations", "Match": { "Path": "/docs/accommodations/swagger/{**catch-all}" }, "Transforms": [ { "PathRemovePrefix": "/docs/accommodations" } ] },
      "docs-bookings": { "ClusterId": "bookings", "Match": { "Path": "/docs/bookings/swagger/{**catch-all}" }, "Transforms": [ { "PathRemovePrefix": "/docs/bookings" } ] },
      "docs-profiles": { "ClusterId": "profiles", "Match": { "Path": "/docs/profiles/swagger/{**catch-all}" }, "Transforms": [ { "PathRemovePrefix": "/docs/profiles" } ] },
      "docs-analytics": { "ClusterId": "analytics", "Match": { "Path": "/docs/analytics/swagger/{**catch-all}" }, "Transforms": [ { "PathRemovePrefix": "/docs/analytics" } ] }
    },
    "Clusters": {
      "identity": { "Destinations": { "primary": { "Address": "http://localhost:5101" } } },
      "accommodations": { "Destinations": { "primary": { "Address": "http://localhost:5102" } } },
      "bookings": { "Destinations": { "primary": { "Address": "http://localhost:5103" } } },
      "profiles": { "Destinations": { "primary": { "Address": "http://localhost:5104" } } },
      "analytics": { "Destinations": { "primary": { "Address": "http://localhost:5105" } } }
    }
  }
}

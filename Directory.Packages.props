<Project>
    <!-- Central package management: one version of each package for every project. -->
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>
    <ItemGroup>
        <!-- Messaging (MassTransit 8.x is the last Apache-2.0 line; 9.x requires a commercial license) -->
        <PackageVersion Include="MassTransit" Version="8.5.11" />
        <PackageVersion Include="MassTransit.RabbitMQ" Version="8.5.11" />
        <PackageVersion Include="MassTransit.EntityFrameworkCore" Version="8.5.11" />
        <!-- API gateway -->
        <PackageVersion Include="Yarp.ReverseProxy" Version="2.3.0" />
        <!-- Persistence -->
        <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="9.0.10" />
        <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="9.0.10" />
        <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.10" />
        <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="9.0.10" />
        <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.10" />
        <PackageVersion Include="Pomelo.EntityFrameworkCore.MySql" Version="9.0.0" />
        <PackageVersion Include="EntityFrameworkCore.CreatedUpdatedDate" Version="8.0.0" />
        <PackageVersion Include="AspNetCore.HealthChecks.MySql" Version="9.0.0" />
        <PackageVersion Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="9.0.10" />
        <!-- Hosting (worker) -->
        <PackageVersion Include="Microsoft.Extensions.Hosting" Version="9.0.10" />
        <!-- HTTP / resilience -->
        <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="9.10.0" />
        <PackageVersion Include="Polly" Version="8.7.0" />
        <!-- Documentation -->
        <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="9.0.10" />
        <PackageVersion Include="Scalar.AspNetCore" Version="2.17.4" />
        <PackageVersion Include="Swashbuckle.AspNetCore" Version="9.0.6" />
        <PackageVersion Include="Swashbuckle.AspNetCore.Annotations" Version="9.0.6" />
        <PackageVersion Include="Swashbuckle.AspNetCore.SwaggerUI" Version="9.0.6" />
        <!-- Security -->
        <PackageVersion Include="BCrypt.Net-Next" Version="4.0.3" />
        <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.14.0" />
        <PackageVersion Include="Microsoft.IdentityModel.Tokens" Version="8.14.0" />
        <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.10" />
        <!-- Misc -->
        <PackageVersion Include="Cortex.Mediator" Version="2.1.0" />
        <PackageVersion Include="Humanizer" Version="2.14.1" />
        <PackageVersion Include="MailKit" Version="4.18.0" />
        <PackageVersion Include="StackExchange.Redis" Version="2.13.17" />
        <PackageVersion Include="Apache.NMS" Version="2.2.0" />
        <PackageVersion Include="Apache.NMS.ActiveMQ" Version="2.2.0" />
        <!-- Tests -->
        <PackageVersion Include="coverlet.collector" Version="6.0.2" />
        <PackageVersion Include="FluentAssertions" Version="8.10.0" />
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
        <PackageVersion Include="xunit" Version="2.9.2" />
        <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
        <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="9.0.10" />
    </ItemGroup>
</Project>
